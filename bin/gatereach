#!/bin/sh
# Finds or fetches the gatereach binary of this plugin's version and runs it with the given arguments
# 1. `<home>/bin/v<version>/gatereach` when a previous run fetched or built it
# 2. The GitHub release of that version for this OS and architecture verified against its `checksums.txt`
#    and against its build provenance when gh is installed and logged in
# 3. go install of the same version when Go is present and the release couldn't be fetched
# 4. Another gatereach on PATH when it answers the plugin version
# Home is GATEREACH_HOME or else ~/.gatereach
# The version comes from the plugin manifest so the plugin and the binary it runs never drift
set -eu

REPO="jeon-jihyeon/gatereach"
# Seconds steps 2 and 3 are skipped after both failed
# so calls before a release don't each pay for the network
MISS_TTL=600
ROOT=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
MANIFEST="${ROOT}/.claude-plugin/plugin.json"

version=$(sed -n 's/^[[:space:]]*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$MANIFEST" | head -n 1)
if [ -z "$version" ]; then
  echo "gatereach: no version in ${MANIFEST}" >&2
  exit 1
fi
if [ -n "${GATEREACH_HOME:-}" ]; then
  HOME_DIR="$GATEREACH_HOME"
elif [ -n "${HOME:-}" ]; then
  HOME_DIR="${HOME}/.gatereach"
else
  echo "gatereach: neither GATEREACH_HOME nor HOME is set, so there's nowhere to keep the binary" >&2
  exit 1
fi
# go install refuses a relative GOBIN and a relative cache would follow the working folder
case "$HOME_DIR" in
  /*) ;;
  *) HOME_DIR="$(pwd -P)/${HOME_DIR}" ;;
esac
TAG="v${version}"
BIN_DIR="${HOME_DIR}/bin/${TAG}"
BIN="${BIN_DIR}/gatereach"
MISS="${BIN_DIR}/.miss"

if [ -x "$BIN" ]; then
  exec "$BIN" "$@"
fi

os=$(uname -s | tr '[:upper:]' '[:lower:]')
arch=$(uname -m)
case "$arch" in
  x86_64) arch=amd64 ;;
  aarch64 | arm64) arch=arm64 ;;
esac
ARCHIVE="gatereach_${os}_${arch}.tar.gz"
BASE_URL="https://github.com/${REPO}/releases/download/${TAG}"

sha256() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | cut -d ' ' -f 1
    return
  fi
  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | cut -d ' ' -f 1
    return
  fi
  return 1
}

# Returns 1 when the release can't be fetched so the next source is tried
# 1. curl speaks only HTTPS with TLS 1.2 or later even across redirects
# 2. A checksum mismatch exits since the download can't be trusted
# 3. With gh on PATH and logged in the archive must carry this repository's build attestation or it exits
# 4. Without gh or its login only the checksum is checked since gh can't verify without a token
# 5. The binary is unpacked in a temp directory and renamed so the cached path never holds a partial file
fetch() {
  command -v curl >/dev/null 2>&1 || return 1
  tmp=$(mktemp -d "${BIN_DIR}/.fetch.XXXXXX") || return 1
  if ! curl -fsSL --proto '=https' --tlsv1.2 --connect-timeout 5 --max-time 60 "${BASE_URL}/${ARCHIVE}" -o "${tmp}/${ARCHIVE}" 2>/dev/null ||
    ! curl -fsSL --proto '=https' --tlsv1.2 --connect-timeout 5 --max-time 30 "${BASE_URL}/checksums.txt" -o "${tmp}/checksums.txt" 2>/dev/null; then
    rm -rf "$tmp"
    return 1
  fi
  if ! got=$(sha256 "${tmp}/${ARCHIVE}") || [ -z "$got" ]; then
    echo "gatereach: can't compute the sha256 of ${ARCHIVE} with sha256sum or shasum, so it isn't trusted" >&2
    rm -rf "$tmp"
    return 1
  fi
  want=$(awk -v f="$ARCHIVE" '$2 == f { print $1 }' "${tmp}/checksums.txt")
  if [ -z "$want" ] || [ "$want" != "$got" ]; then
    echo "gatereach: checksum of ${BASE_URL}/${ARCHIVE} doesn't match checksums.txt, refusing to run it" >&2
    rm -rf "$tmp"
    exit 1
  fi
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1 && ! gh attestation verify "${tmp}/${ARCHIVE}" --repo "$REPO" >/dev/null; then
    echo "gatereach: gh attestation verify failed for ${BASE_URL}/${ARCHIVE}, refusing to run it" >&2
    rm -rf "$tmp"
    exit 1
  fi
  if ! tar -xzf "${tmp}/${ARCHIVE}" -C "$tmp" gatereach || ! chmod +x "${tmp}/gatereach" || ! mv -f "${tmp}/gatereach" "$BIN"; then
    rm -rf "$tmp"
    return 1
  fi
  rm -rf "$tmp"
  echo "gatereach: fetched ${BASE_URL}/${ARCHIVE} into ${BIN}" >&2
}

# go install writes its target in place
# so it builds into a temp directory that's renamed like a fetch
build() {
  command -v go >/dev/null 2>&1 || return 1
  echo "gatereach: couldn't fetch release ${TAG} for ${os}/${arch}, building with go install" >&2
  tmp=$(mktemp -d "${BIN_DIR}/.build.XXXXXX") || return 1
  if ! GOBIN="$tmp" go install "github.com/${REPO}/cmd/gatereach@${TAG}" || ! mv -f "${tmp}/gatereach" "$BIN"; then
    rm -rf "$tmp"
    return 1
  fi
  rm -rf "$tmp"
}

# True while the last failed fetch and build are younger than MISS_TTL
missed() {
  [ -f "$MISS" ] || return 1
  at=$(cat "$MISS" 2>/dev/null || true)
  now=$(date +%s)
  case "$at" in
    '' | *[!0-9]*) return 1 ;;
  esac
  [ $((now - at)) -lt "$MISS_TTL" ]
}

# A nested launcher skips the network since the launcher that asked it already tried
if [ -z "${GATEREACH_NESTED:-}" ] && ! missed; then
  if mkdir -p "$BIN_DIR" 2>/dev/null; then
    if fetch || build; then
      rm -f "$MISS"
      exec "$BIN" "$@"
    fi
    date +%s >"$MISS" 2>/dev/null || true
  fi
fi

# Physical directory and file name
# so a PATH entry that reaches this launcher by another spelling is recognized
real() {
  dir=$(CDPATH='' cd -P -- "$(dirname -- "$1")" 2>/dev/null && pwd -P) || return 1
  printf '%s/%s\n' "$dir" "$(basename -- "$1")"
}

# The first gatereach on PATH that isn't this launcher
# 1. command -v names only the first match and that's this launcher when the plugin bin directory comes first
# 2. Globbing is off while PATH is split so an entry with a wildcard stays literal
# 3. Empty and relative entries are skipped so a gatereach in the current directory never runs
# 4. GATEREACH_NESTED marks a launcher asked for its version by another launcher
#    It skips the network and this step so two copies of the launcher on PATH never ask each other without end
found=""
if [ -z "${GATEREACH_NESTED:-}" ]; then
  self=$(real "$0" || true)
  set -f
  old_ifs=$IFS
  IFS=:
  for dir in $PATH; do
    IFS=$old_ifs
    case "$dir" in
      /*) ;;
      *) continue ;;
    esac
    candidate="${dir}/gatereach"
    if [ -f "$candidate" ] && [ -x "$candidate" ] && [ "$(real "$candidate")" != "$self" ]; then
      found=$candidate
      break
    fi
  done
  IFS=$old_ifs
  set +f
fi
if [ -n "$found" ]; then
  have=$(GATEREACH_NESTED=1 "$found" --version 2>/dev/null || echo unknown)
  if [ "$have" = "$version" ]; then
    exec "$found" "$@"
  fi
  echo "gatereach: ${found} on PATH is version ${have} but the plugin needs ${version}" >&2
fi

echo "gatereach: couldn't fetch ${TAG} from ${BASE_URL} or build it with Go. Install Go from https://go.dev/dl, or put a gatereach ${version} binary on PATH. The next try comes after ${MISS_TTL} seconds, or delete ${MISS} to try now" >&2
exit 1
